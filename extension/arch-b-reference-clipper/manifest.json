{
  "manifest_version": 3,
  "name": "ARCH-B 참고사이트 등록",
  "description": "현재 페이지의 제목·설명·이미지를 확인하고 ARCH-B 참고사이트로 등록합니다.",
  "version": "0.2.0",
  "minimum_chrome_version": "127",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ARCH-B 참고사이트 등록",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png" }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": [
    "https://www.archbehind.com/*",
    "https://archbehind.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.archbehind.com/extension/connect*",
        "https://archbehind.com/extension/connect*",
        "http://localhost/extension/connect*",
        "http://127.0.0.1/extension/connect*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ]
}
